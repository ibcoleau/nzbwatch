# REQUIRED - choose a strong password and an independent long random signing secret.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_PASSWORD
APP_SECRET=CHANGE_TO_A_RANDOM_64_CHARACTERS_OR_MORE_SIGNING_SECRET

# Use service/container DNS names on the same Docker network, or reachable LAN addresses.
# The URLs are from the perspective of the NZBWatch container (NOT the browser).
HYDRA_URL=http://192.168.1.10:5076
HYDRA_API_KEY=
SAB_URL=http://192.168.1.10:8080
SAB_API_KEY=

PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Options: found,queued,completed,failed (comma-separated)
NOTIFY_EVENTS=found,completed,failed
# Safety limit for the number of automatic submissions per watch, per scan (1-20).
MAX_QUEUES_PER_SCAN=3

# For LAN access. Bind 127.0.0.1 when using an HTTPS reverse proxy on the same host.
APP_BIND=0.0.0.0
APP_PORT=8787
# Set true only if accessed through HTTPS; behind a TLS proxy set to true.
COOKIE_SECURE=false
LOG_LEVEL=INFO
