# Authentication remains managed through Docker environment variables.
# Change these and recreate the container if needed.
ADMIN_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_PASSWORD
APP_SECRET=CHANGE_TO_A_RANDOM_SIGNING_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false

# Optional FIRST BOOT import only (ignored after /data/config.json exists).
# Or leave blank and configure entirely in the browser.
HYDRA_URL=
HYDRA_API_KEY=
SAB_URL=
SAB_API_KEY=
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
NOTIFY_EVENTS=found,completed,failed
MAX_QUEUES_PER_SCAN=3

APP_BIND=0.0.0.0
APP_PORT=8787
LOG_LEVEL=INFO
TZ=Australia/Hobart
